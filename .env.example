# Frontend: copy this setting to frontend/.env or configure it in Vercel.
VITE_API_BASE_URL=https://your-backend.onrender.com

# Backend: configure these in Render's environment settings.
APP_NAME=ScamShield AI API
APP_VERSION=0.1.0
ENVIRONMENT=production
CORS_ORIGINS=https://your-project.vercel.app
DATABASE_URL=sqlite:////var/data/scamshield.db
ML_ENABLED=true
WEBSITE_INSPECTION_ENABLED=true
WEBSITE_INSPECTION_TIMEOUT_SECONDS=5.0
WEBSITE_INSPECTION_MAX_REDIRECTS=3
WEBSITE_INSPECTION_MAX_BYTES=524288
GOOGLE_SAFE_BROWSING_API_KEY=
URLHAUS_ENABLED=false
URLHAUS_AUTH_KEY=
THREAT_INTEL_PROVIDER=
THREAT_INTEL_API_KEY=
THREAT_INTEL_ENDPOINT_URL=
THREAT_INTEL_TIMEOUT_SECONDS=3.0
THREAT_INTEL_CACHE_TTL_SECONDS=300
