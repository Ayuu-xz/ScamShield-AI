# Backend environment configuration (copy to .env if needed)
APP_NAME=ScamShield AI API
APP_VERSION=0.1.0
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=sqlite:///./scamshield.db

# Optional Isolated Read-Only Website Inspection
WEBSITE_INSPECTION_ENABLED=true
WEBSITE_INSPECTION_TIMEOUT_SECONDS=5.0
WEBSITE_INSPECTION_MAX_REDIRECTS=3
WEBSITE_INSPECTION_MAX_BYTES=524288

# Optional external Threat Intelligence / Domain Reputation Providers
# Leave blank to run in offline mode (reputation checks report "Check unavailable")
GOOGLE_SAFE_BROWSING_API_KEY=
URLHAUS_ENABLED=false
URLHAUS_AUTH_KEY=
THREAT_INTEL_PROVIDER=
THREAT_INTEL_API_KEY=
THREAT_INTEL_ENDPOINT_URL=
THREAT_INTEL_TIMEOUT_SECONDS=3.0
THREAT_INTEL_CACHE_TTL_SECONDS=300
